# URL of backend API base (e.g., https://api.example.com)
REACT_APP_API_BASE=

# Comma-separated feature flags. Include 'mock' or 'mock-data' to enable frontend mock data.
REACT_APP_FEATURE_FLAGS=mock

# Optional additional environment variables that may be present in runtime:
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=
REACT_APP_ENABLE_SOURCE_MAPS=
REACT_APP_PORT=
REACT_APP_TRUST_PROXY=
REACT_APP_LOG_LEVEL=
REACT_APP_HEALTHCHECK_PATH=
REACT_APP_EXPERIMENTS_ENABLED=
